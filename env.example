# Copy to .env at the repo root. Loaded at app startup only — restart after edits.
# See RUNPOD.md for RunPod pod vs serverless details.

# Google Gemini text completions (LLM menu prefix gemini:)
GEMINI_API_KEY=your/key/here

# Ollama API base (plain model names in the LLM menu)
OLLAMA_HOST=http://localhost:11434

# LM Studio OpenAI-compatible API (LLM menu prefix lmstudio:)
LMSTUDIO_HOST=http://localhost:1234

# glm-ocr chain: Ollama vision model for the page OCR pass (optional prompt override)
GLM_OCR_MODEL=glm-ocr
# GLM_OCR_PROMPT=Transcribe all text visible on this form page.

# Optional path to the tesseract binary (Windows auto-discovers if unset)
# TESSERACT_CMD=

# Optional SQLite path for run statistics (default: app-data Digidoocs/FormReaderComparitor)
# FORM_READER_DB=

# --- RunPod (LLM menu prefix runpod:) ---
# GPU pod OpenAI proxy is preferred. /v1 is appended if missing.
# Do not put a pod id in RUNPOD_ENDPOINT_ID.
RUNPOD_HOST=https://your-pod-id-8000.proxy.runpod.net
# Exact id from GET {RUNPOD_HOST}/v1/models (often --served-model-name)
RUNPOD_MODEL=qwen3-vl-8b-instruct
# Required for serverless; optional on a pod unless vLLM was started with --api-key
RUNPOD_API_KEY=your/runpod/api/key
# Serverless endpoint id only (unused when RUNPOD_HOST is set)
# RUNPOD_ENDPOINT_ID=your-endpoint-id
